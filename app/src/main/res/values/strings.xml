<?xml version="1.0" encoding="utf-8"?>
<!--
  默认语言：英文。除简体中文（values-zh-rCN）外的所有语言都回落到这里。
  新增文案必须同时在 values-zh-rCN/strings.xml 写一份，否则中文手机会显示英文。
-->
<resources>
    <string name="app_name">ESR</string>
    <string name="accessibility_desc">Shows a full-screen rest overlay and captures the volume key for emergency exit.</string>

    <!-- 主界面：标题区说明 -->
    <string name="intro_main">A full-screen rest overlay appears once continuous screen time reaches the limit, and dismisses itself when the countdown ends.</string>
    <string name="intro_escape">Press volume down 5 times while the overlay is shown to exit immediately.</string>
    <string name="intro_brightness">Minimum brightness: enter a control value from 0 to 255; brightness below it is pulled back up. Empty or 0 disables it. The slider scale is not linear — a control value of 64 reads about 50 on it.</string>

    <!-- 主界面：状态行标签 -->
    <string name="label_accessibility">Accessibility service</string>
    <string name="label_shizuku">Shizuku permission</string>
    <string name="label_used">Used this session</string>
    <string name="label_until_break">Until break</string>
    <string name="label_phase">Timer status</string>
    <string name="label_brightness">Screen brightness</string>
    <string name="label_min_brightness">Minimum brightness</string>
    <string name="label_write_settings">Modify system settings</string>

    <!-- 主界面：按钮 -->
    <string name="btn_enable_accessibility">Enable accessibility service</string>
    <string name="btn_grant_shizuku">Grant Shizuku (media control)</string>
    <string name="btn_test_overlay">Test overlay now</string>
    <string name="btn_reset">Reset counter</string>
    <string name="btn_save_threshold">Save threshold</string>
    <string name="btn_save_brightness">Save minimum brightness</string>
    <string name="btn_allow_write_settings">Allow modifying system settings</string>

    <!-- 主界面：输入与提示 -->
    <string name="title_threshold">Threshold (minutes)</string>
    <string name="hint_brightness">Minimum brightness control value (1-255), empty or 0 = off</string>
    <string name="toast_shizuku_missing">Shizuku not detected. Start the Shizuku service first.</string>
    <string name="toast_shizuku_granted">Shizuku is already granted</string>
    <string name="toast_need_accessibility">Enable the accessibility service first</string>
    <string name="toast_reset_done">Counter reset</string>
    <string name="toast_invalid_minutes">Enter a positive number of minutes</string>
    <string name="toast_threshold_saved">Saved: %1$d minutes</string>
    <string name="toast_invalid_brightness">Enter an integer between 0 and 255 (0 = off)</string>
    <string name="toast_brightness_off">Minimum brightness disabled</string>
    <string name="toast_brightness_saved">Minimum brightness set to %1$d (slider reads about %2$d)</string>
    <string name="toast_write_granted">Permission already granted</string>
    <string name="toast_write_failed">Cannot open the settings page. Grant it manually in Special access → Modify system settings.</string>

    <!-- 主界面：状态值 -->
    <string name="state_enabled">Enabled</string>
    <string name="state_disabled">Disabled</string>
    <string name="state_not_running">Not running</string>
    <string name="state_granted">Granted</string>
    <string name="state_not_granted">Not granted</string>
    <string name="state_service_stopped">Service not running</string>
    <string name="state_read_failed">Read failed</string>
    <string name="state_not_set">Not set</string>
    <string name="phase_no_gaze">No gaze detected, paused</string>
    <string name="phase_gaze">Gaze timing</string>
    <string name="phase_screen">Screen-on timing</string>
    <string name="phase_screen_off">Paused (screen off)</string>

    <!-- 数值格式 -->
    <string name="fmt_until_break">%1$s (limit %2$d min)</string>
    <string name="fmt_brightness_with_min">%1$d (slider reads about %2$d, min %3$d)</string>
    <string name="fmt_value_with_pos">%1$d (slider reads about %2$d)</string>
    <string name="fmt_duration_min_sec">%1$d min %2$d s</string>
    <string name="fmt_duration_sec">%1$d s</string>

    <!-- 通知 -->
    <string name="channel_name">Screen time</string>
    <string name="notif_title">Screen break reminder</string>
    <string name="notif_tracking">Tracking screen usage time</string>
    <string name="notif_guard_off">Accessibility service is off, overlay unavailable</string>
    <string name="notif_gaze_paused">No gaze detected, paused (%1$d min used)</string>
    <string name="notif_used">%1$d min used, break in about %2$d min</string>
    <string name="notif_screen_off">%1$d min used (screen off, paused)</string>
    <string name="notif_cannot_show">Cannot show break overlay</string>
    <string name="notif_enable_guard">Enable the ESR accessibility service in system settings</string>

    <!-- 浮窗 -->
    <string name="overlay_hint">Take a break</string>
    <string name="overlay_pause">Pause</string>
    <string name="overlay_resume">Resume</string>
    <string name="overlay_content_desc">Rest countdown</string>

    <string name="toast_shizuku_denied">Shizuku permission denied</string>

    <!-- 浮窗时间格式：英文用 2026-11-02 Monday / 12:13:46 PM -->
    <string name="date_pattern">yyyy-MM-dd EEEE</string>
    <string name="time_pattern">h:mm:ss a</string>
</resources>
